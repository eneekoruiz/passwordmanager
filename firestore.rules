rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: vaults
// Document ID: {uid} (Firebase Auth UID)
// Fields:
//   - encrypted_vault_blob: string (required, 1..1048576 chars)
//   - updated_at: string (required, 1..64 chars)
//
// Collection: users/{uid}/documents
// Document ID: {docId} (UUID)
// Fields:
//   - id: string (required, == docId, 1..128 chars, immutable)
//   - name: string (required, 1..512 chars)
//   - size: int (required, 0..104857600)
//   - mimeType: string (required, 0..255 chars; may be "" for unknown types)
//   - uploadedAt: string (required, 1..64 chars, immutable)
//   - chunks: int (required, 1..500)
//   - role: string (optional, 'front' | 'back' | 'main')
//
// Collection: users/{uid}/documentChunks
// Document ID: {chunkId} ({fileId}_chunk_{index})
// Fields:
//   - data: string (required, 1..1200000 chars)
//   - index: int (required, 0..499, immutable)
//   - fileId: string (required, 1..128 chars, immutable)
//
// Collection: publicKeys
// Document ID: {uid} (Firebase Auth UID)
// Fields:
//   - publicKey: string (required, 1..8192 chars)
//   - updatedAt: string (required, 1..64 chars)
//
// Collection: directory
// Document ID: {emailHash} (SHA-256 hex of normalized email)
// Fields:
//   - uid: string (required, == request.auth.uid, 1..128 chars, immutable)
//   - updatedAt: string (required, 1..64 chars)
//
// Collection: shares
// Document ID: {shareId} (UUID; create/read/delete only, never updated)
// Fields:
//   - id: string (required, == shareId, 1..128 chars)
//   - recipientUid: string (required, 1..128 chars)
//   - recipientEmail: string (optional, 0..320 chars)
//   - senderUid: string (required, == request.auth.uid, 1..128 chars)
//   - senderEmail: string (optional, 0..320 chars)
//   - platformName: string (required, 1..512 chars)
//   - payloadType: string (optional, 'single' | 'bundle')
//   - encryptedPayload: string (required, 1..262144 chars)
//   - createdAt: string (required, 1..64 chars)
//
// Collection: links
// Document ID: {linkId} (UUID)
// Fields:
//   - id: string (required, == linkId, 1..128 chars, immutable)
//   - iv: string (required, 1..128 chars, immutable)
//   - encryptedPayload: string (required, 1..524288 chars, immutable)
//   - createdAt: string (required, 1..64 chars, immutable)
//   - expiresAt: number | null (required, null or > 0 epoch ms)
//   - burnAfterRead: bool (required)
//   - burned: bool (required; false on create, one-way false -> true for visitors)
//   - payloadType: string (optional on legacy, required on create, 'single' | 'bundle')
//   - platformName: string (required, 1..512 chars)
//   - senderUid: string (required, == request.auth.uid on create, 1..128 chars, immutable)
//   - viewsCount: int (optional on legacy, 0 on create, >= 0)
//   - viewedDevices: list (optional on legacy, [] on create, size <= 50)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function validStringLength(data, field, minLen, maxLen) {
      return data[field] is string
        && data[field].size() >= minLen
        && data[field].size() <= maxLen;
    }

    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data)
        || (data[field] is string
          && data[field].size() >= minLen
          && data[field].size() <= maxLen);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidVault(data) {
      return hasOnlyAllowedFields(['encrypted_vault_blob', 'updated_at'])
        && hasRequiredFields(['encrypted_vault_blob', 'updated_at'])
        && validStringLength(data, 'encrypted_vault_blob', 1, 1048576)
        && validStringLength(data, 'updated_at', 1, 64);
    }

    function isValidUserDocument(data, docId) {
      return hasOnlyAllowedFields(['id', 'name', 'size', 'mimeType', 'uploadedAt', 'chunks', 'role'])
        && hasRequiredFields(['id', 'name', 'size', 'mimeType', 'uploadedAt', 'chunks'])
        && validStringLength(data, 'id', 1, 128)
        && data.id == docId
        && validStringLength(data, 'name', 1, 512)
        && data.size is int && data.size >= 0 && data.size <= 104857600
        && validStringLength(data, 'mimeType', 0, 255)
        && validStringLength(data, 'uploadedAt', 1, 64)
        && data.chunks is int && data.chunks >= 1 && data.chunks <= 500
        && (!('role' in data) || data.role in ['front', 'back', 'main']);
    }

    function isValidDocumentChunk(data) {
      return hasOnlyAllowedFields(['data', 'index', 'fileId'])
        && hasRequiredFields(['data', 'index', 'fileId'])
        && validStringLength(data, 'data', 1, 1200000)
        && data.index is int && data.index >= 0 && data.index < 500
        && validStringLength(data, 'fileId', 1, 128);
    }

    function isValidPublicKey(data) {
      return hasOnlyAllowedFields(['publicKey', 'updatedAt'])
        && hasRequiredFields(['publicKey', 'updatedAt'])
        && validStringLength(data, 'publicKey', 1, 8192)
        && validStringLength(data, 'updatedAt', 1, 64);
    }

    function isValidDirectoryEntry(data) {
      return hasOnlyAllowedFields(['uid', 'updatedAt'])
        && hasRequiredFields(['uid', 'updatedAt'])
        && validStringLength(data, 'uid', 1, 128)
        && data.uid == request.auth.uid
        && validStringLength(data, 'updatedAt', 1, 64);
    }

    function isValidShare(data, shareId) {
      return hasOnlyAllowedFields([
          'id', 'recipientUid', 'recipientEmail', 'senderUid', 'senderEmail',
          'platformName', 'payloadType', 'encryptedPayload', 'createdAt'
        ])
        && hasRequiredFields([
          'id', 'recipientUid', 'senderUid', 'platformName', 'encryptedPayload', 'createdAt'
        ])
        && validStringLength(data, 'id', 1, 128)
        && data.id == shareId
        && validStringLength(data, 'recipientUid', 1, 128)
        && isValidOptionalString(data, 'recipientEmail', 0, 320)
        && validStringLength(data, 'senderUid', 1, 128)
        && data.senderUid == request.auth.uid
        && isValidOptionalString(data, 'senderEmail', 0, 320)
        && validStringLength(data, 'platformName', 1, 512)
        && (!('payloadType' in data) || data.payloadType in ['single', 'bundle'])
        && validStringLength(data, 'encryptedPayload', 1, 262144)
        && validStringLength(data, 'createdAt', 1, 64);
    }

    function isLinkActive(data) {
      return ('expiresAt' in data)
        && (data.expiresAt == null || (data.expiresAt is number && data.expiresAt > request.time.toMillis()))
        && data.burned != true;
    }

    function isValidLinkDocument(data, linkId) {
      return hasOnlyAllowedFields([
          'id', 'iv', 'encryptedPayload', 'createdAt', 'expiresAt',
          'burnAfterRead', 'burned', 'payloadType', 'platformName',
          'senderUid', 'viewsCount', 'viewedDevices'
        ])
        && hasRequiredFields([
          'id', 'iv', 'encryptedPayload', 'createdAt', 'expiresAt',
          'burnAfterRead', 'burned', 'platformName', 'senderUid'
        ])
        && validStringLength(data, 'id', 1, 128)
        && data.id == linkId
        && validStringLength(data, 'iv', 1, 128)
        && validStringLength(data, 'encryptedPayload', 1, 524288)
        && validStringLength(data, 'createdAt', 1, 64)
        && (data.expiresAt == null || (data.expiresAt is number && data.expiresAt > 0))
        && data.burnAfterRead is bool
        && data.burned is bool
        && (!('payloadType' in data) || data.payloadType in ['single', 'bundle'])
        && validStringLength(data, 'platformName', 1, 512)
        && validStringLength(data, 'senderUid', 1, 128)
        && (!('viewsCount' in data) || (data.viewsCount is int && data.viewsCount >= 0))
        && (!('viewedDevices' in data) || (data.viewedDevices is list && data.viewedDevices.size() <= 50));
    }

    function isValidLinkCreate(data, linkId) {
      return isAuthenticated()
        && isValidLinkDocument(data, linkId)
        && data.senderUid == request.auth.uid
        && data.burned == false
        && ('payloadType' in data)
        && ('viewsCount' in data) && data.viewsCount == 0
        && ('viewedDevices' in data) && data.viewedDevices.size() == 0;
    }

    function isValidLinkSenderUpdate(linkId) {
      return isAuthenticated()
        && resource.data.senderUid == request.auth.uid
        && isValidLinkDocument(request.resource.data, linkId)
        && areImmutableFieldsUnchanged(['id', 'iv', 'encryptedPayload', 'createdAt', 'senderUid']);
    }

    function isValidVisitorBurn(affected) {
      return !('burned' in affected) || (
        resource.data.burnAfterRead == true
        && resource.data.burned == false
        && request.resource.data.burned == true
      );
    }

    function isValidVisitorViewsCount(affected) {
      return !('viewsCount' in affected) || (
        request.resource.data.viewsCount is int
        && (
          ('viewsCount' in resource.data && resource.data.viewsCount is int
            && request.resource.data.viewsCount == resource.data.viewsCount + 1)
          || (!('viewsCount' in resource.data) && request.resource.data.viewsCount == 1)
        )
      );
    }

    function isValidVisitorViewedDevices(affected) {
      return !('viewedDevices' in affected) || (
        // Do not permit altering viewedDevices without also incrementing viewsCount
        ('viewsCount' in affected)
        && request.resource.data.viewedDevices is list
        && request.resource.data.viewedDevices.size() <= 50
        && (
          (!('viewedDevices' in resource.data)
            && request.resource.data.viewedDevices.size() == 1
            && request.resource.data.viewedDevices[0] is string
            && request.resource.data.viewedDevices[0].size() > 0
            && request.resource.data.viewedDevices[0].size() <= 64)
          || ('viewedDevices' in resource.data
            && resource.data.viewedDevices is list
            && request.resource.data.viewedDevices.hasAll(resource.data.viewedDevices)
            && request.resource.data.viewedDevices.size() == resource.data.viewedDevices.size() + 1
            && request.resource.data.viewedDevices[resource.data.viewedDevices.size()] is string
            && request.resource.data.viewedDevices[resource.data.viewedDevices.size()].size() > 0
            && request.resource.data.viewedDevices[resource.data.viewedDevices.size()].size() <= 64)
        )
      );
    }

    function isValidLinkVisitorUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return isLinkActive(resource.data)
        && affected.size() > 0
        && affected.hasOnly(['burned', 'viewsCount', 'viewedDevices'])
        && isValidVisitorBurn(affected)
        && isValidVisitorViewsCount(affected)
        && isValidVisitorViewedDevices(affected);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Encrypted user vault blobs: strictly owner-only
    match /vaults/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidVault(request.resource.data);
      allow update: if isOwner(uid) && isValidVault(request.resource.data);
      allow delete: if isOwner(uid);
    }

    // Encrypted document metadata: strictly owner-only
    match /users/{uid}/documents/{docId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidUserDocument(request.resource.data, docId);
      allow update: if isOwner(uid)
        && isValidUserDocument(request.resource.data, docId)
        && areImmutableFieldsUnchanged(['id', 'uploadedAt']);
      allow delete: if isOwner(uid);
    }

    // Encrypted document chunks: strictly owner-only with chunk size cap
    match /users/{uid}/documentChunks/{chunkId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidDocumentChunk(request.resource.data);
      allow update: if isOwner(uid)
        && isValidDocumentChunk(request.resource.data)
        && areImmutableFieldsUnchanged(['fileId', 'index']);
      allow delete: if isOwner(uid);
    }

    // Public RSA-OAEP keys (no PII): readable by authenticated users, writable only by owner
    match /publicKeys/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid) && isValidPublicKey(request.resource.data);
      allow update: if isOwner(uid) && isValidPublicKey(request.resource.data);
      allow delete: if isOwner(uid);
    }

    // Email-hash -> UID lookup directory: prevent emailHash hijacking on existing entries
    match /directory/{emailHash} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidDirectoryEntry(request.resource.data);
      allow update: if isAuthenticated()
        && isDocOwner()
        && uidNotModified()
        && isValidDirectoryEntry(request.resource.data);
      allow delete: if isAuthenticated() && isDocOwner();
    }

    // P2P encrypted shares: readable/deletable by sender or recipient, never updated
    match /shares/{shareId} {
      allow read: if isAuthenticated()
        && (resource.data.recipientUid == request.auth.uid
          || resource.data.senderUid == request.auth.uid);
      allow create: if isAuthenticated() && isValidShare(request.resource.data, shareId);
      allow update: if false;
      allow delete: if isAuthenticated()
        && (resource.data.recipientUid == request.auth.uid
          || resource.data.senderUid == request.auth.uid);
    }

    // Magic links: get active link by ID (or sender), list only own links, one-way burn/view telemetry
    match /links/{linkId} {
      allow get: if isLinkActive(resource.data)
        || (isAuthenticated() && resource.data.senderUid == request.auth.uid);
      allow list: if isAuthenticated() && resource.data.senderUid == request.auth.uid;
      allow create: if isValidLinkCreate(request.resource.data, linkId);
      allow update: if isValidLinkSenderUpdate(linkId) || isValidLinkVisitorUpdate();
      allow delete: if isAuthenticated() && resource.data.senderUid == request.auth.uid;
    }

    // Default deny for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
